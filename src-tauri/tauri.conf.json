{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QR Code Generator",
  "version": "0.1.0",
  "identifier": "app.qrcodegenerator.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QR Code Generator",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Ravando",
    "copyright": "\u00a9 2026 QR Code Generator contributors",
    "category": "Utility",
    "shortDescription": "A fast, local QR code generator.",
    "longDescription": "Paste a link, get a QR code, export it as SVG or PNG. Codes are static, so they never expire and never phone home. Everything runs locally with no account and no network.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
